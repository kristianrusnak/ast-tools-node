        "npx",
        "--node-options=--use-system-ca",
        "-y",
        "github:ainthek/paper-search-mcp-nodejs"
      ]
    }
  },
  "permission": {
    /*  DD: All skills are denied by default. 
        Each agent enables skills in it's own MD or in kilo.jsonc config
        This prevents system context overkill with meny skills
        And allows users to pick skills per project and agent
    */
    "skill": {
      "*": "deny"
    },
    /*  DD: All subagents are denied by default. 
        You must enable avaliable subagents explicitly for all custom or build in agents.
    */
    "task": {
      "*": "deny"
    },
    /*  DD: no agent shall perform git commits, nor git push by defaults
        These operations shall be governed by special agent (by default out gitagent)
    */
    "bash": {
      "git commit": "deny",
      "git push": "deny"
    },
    /*  DD: All MCP server MUST be prefixed with mcp- to be easily recognizable
        kilo-playwright_browser_*" is exceltion since we cannot rename this server (internal by kilo)
        DD: All MCPs are disabled by default and are enabled on per agent bases as needed.
    */
    "mcp-*": "deny",
    "kilo-playwright_browser_*": "deny",
    /*  DD: deny editing of the local tools source under .kilo/tools
            some rogue prompts tend to write their own tools here (for what reason ?)
            See https://gitlab01.hq.gratex.com/ai/ai-init/-/issues/22
    */
    "edit": {
      ".kilo/tools/**": "deny"
    }
  },
  /*  DD: model used for "some tasks and agents" in kilo, like for "Generate a title for this conversation"
      if you dont configure small_model explicitly, every new task in kilotitle generation (new prompt) will end calling google/claude-haiku-4-5
      Safe option a) small_model
  */
  "small_model": "gti-litellm/minimax-m2.5",
  /*  DD: default "big" model */
  "model": "gti-litellm/deepseek-v4-flash",
  /* 
    DD: Explicit agents configuration.
    Since we deny most of global configured MCPs and SKILLs, and TASK's Agents 
  */
  "agent": {
    "title": {
      /* DD: Safe option b) agent.title.model, see model for "Generate a title" */
      "model": "gti-litellm/Qwen3-32b"
    },
    "ask": {
      /*  DD: Ask Agent/Mode is MCP heavy. Contains various MCPs for browsing web and other resources */
      // model good for research and translations and text interpretations
      "model": "gti-litellm/qwen3.6-27b",
      "mode": "all",
      "permission": {
        // traditional
        "mcp-exa_*": "allow",
        "mcp-tavily-mcp_*": "allow",
        "mcp-jina_*": "deny",
        // specialized research
        "mcp-paper-search-nodejs_*": "allow",
        // github ! most searchse shall go to github
        "mcp-github-readonly_*": "allow",
        // and playwright for specialized searches if real browser is needed
        "kilo-playwright_browser_*": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "code": {
      "permission": {
        // even general code definitelly shall search web
        "mcp-exa_*": "allow",
        // and if stucked can launch tasks with specialized subagents
        "task": {
          // code can launch really any subagent
          "*": "allow",
          // code can launch extra coding subagents 
          // "code-*": "allow"
        },
        "mcp-github-readonly_*": "allow",
        "skill": {
          "*": "allow"
        }
      },
      "mode": "all", //DD: code can be launched as subagent as well 
      "model": "gti-litellm/deepseek-v4-flash"
    },
    /*  DD: custom agents for specialized tasks are confugured in ./kilo/agents forlder and 
            include their own set of prompts and permissions 
    */
    /*  DD: task tool cannot switch model, so of specialized subtasks are needed 
            or you want to cross-examine solutions, or solve subtask by external models
            or just waste some money but save time
        
        DD: specialized code modes are intentionally 
            missing search and ask functionality of defalt code agent,    
            allow if needed.
    */
    "code-claude-sonnet-4-6": {
      // WARNING: cloud model, use carefully, remove on sensitive projects
      "model": "gti-litellm/google/claude-sonnet-4-6",
      "description": "Specialized coding agent. Uses model Claude Sonnet 4.6 (via Google). Strong reasoning for complex coding tasks. WARNING: your data is sent to the cloud.",
      "prompt": "{file:./_prompts/agents/code-anthropic.md}",
      "mode": "all"
    },
    "code-gpt-5.5": {
      // WARNING: cloud model, use carefully, remove on sensitive projects
      "model": "gti-litellm/azure/gpt-5.5",
      "description": "Specialized coding agent. Uses model GPT-5.5 (via Azure). Strong reasoning for complex coding tasks. WARNING: your data is sent to the cloud.",
      "prompt": "{file:./_prompts/agents/code-gpt-5.5.md}",
      "mode": "all"
    },
    // on-premise models, add more if needed
    // DD: custom agents must have descriptions, otherwise they fallback to "This subagent should only be called manually by the user."
    "code-minimax": {
      "model": "gti-litellm/minimax-m2.5",
      "description": "Specialized coding agent. Uses model Minimax M2.5 (on-premise). Lightweight coding model.",
      "prompt": "{file:./_prompts/agents/code-default.md}",
      "mode": "all"
    },
    "code-qwen-coder": {
      "model": "gti-litellm/qwen3-coder-next",
      "description": "Specialized coding agent. Uses model Qwen3 Coder Next (on-premise). Qwen-family coding model.",
      "prompt": "{file:./_prompts/agents/code-default.md}",
      "mode": "all"
    },
    "code-nemotron-3-ultra": {
      "model": "gti-litellm/nemotron-3-ultra",
      "description": "Specialized coding agent. Uses model Nemotron-3 Ultra (on-premise). NVIDIA coding model.",
      "prompt": "{file:./_prompts/agents/code-default.md}",
      "mode": "all"
    },
    "code-glm5.2": {
      "model": "gti-litellm/glm-5.2",
      "description": "Specialized coding agent. Uses model GLM-5.2 (on-premise). Zhipu AI coding model.",
      "prompt": "{file:./_prompts/agents/code-default.md}",
      "mode": "all"
    },
    "code-laguna-s-2.1": {
      "model": "gti-litellm/laguna-s-2.1",
      "description": "Specialized coding agent. Uses model Laguna-S 2.1 (on-premise).",
      "prompt": "{file:./_prompts/agents/code-default.md}",
      "mode": "all"
    }
  }
  /* DD: Use only in gratex version (marcus), in old version (erik) This causes failure to load config
         This is extreme measure for complete custom system prompts, see documentation
    "system_soul": "{file:./_prompts/soul.txt}"
  */
}