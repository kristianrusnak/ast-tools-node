#!/usr/bin/env node
'use strict';
// gitlab-search-blobs — search file content in a single GitLab project
//
// Uses: GET /api/v4/projects/:id/search?scope=blobs
// Works on Free tier — no Elasticsearch required.
//
// Required env vars (set by AI agent from .roo/mcp.json):
//   GITLAB_SEARCH_URI    — e.g. https://gitlab.example.com/api/v4
//   GITLAB_SEARCH_TOKEN  — Personal access token with read_api scope
//
// Usage:
//   gitlab-search-blobs <project_id_or_path> <keyword> [options]
//
// Options:
//   --filter <str>    Inline filter: "extension:py" | "filename:*.json" | "path:src/"
//   --per-page <n>    Results per page, max 100 (default: 20)
//   --ref <branch>    Branch/tag to search (default: project default branch)
//   --json            Output raw JSON

const api = require('./gitlab-api.js');

function parseArgs(argv) {
  const opts = { projectId: null, keyword: null, filter: null, perPage: 20, ref: null, json: false };
  let i = 0;
  if (argv[i] && !argv[i].startsWith('--')) opts.projectId = argv[i++];
  if (argv[i] && !argv[i].startsWith('--')) opts.keyword   = argv[i++];
  while (i < argv.length) {
    switch (argv[i]) {
      case '--filter':   opts.filter  = argv[++i]; break;
      case '--per-page': opts.perPage = parseInt(argv[++i], 10); break;
      case '--ref':      opts.ref     = argv[++i]; break;
      case '--json':     opts.json    = true; break;
      default: console.error('Unknown option: ' + argv[i]); process.exit(1);
    }
    i++;
  }
  return opts;
}

async function main() {
  const opts = parseArgs(process.argv.slice(2));
  if (!opts.projectId || !opts.keyword) {
    console.error('Usage: gitlab-search-blobs <project_id_or_path> <keyword> [options]');
    process.exit(1);
  }

  const { uri, token } = api.requireEnv();
  const searchTerm = api.buildSearchTerm(opts.keyword, opts.filter);

  if (!opts.json) process.stderr.write('🔍 Project: ' + opts.projectId + '  keyword: "' + searchTerm + '"\n\n');

  const results = await api.searchProjectBlobs(uri, token, opts.projectId, searchTerm, {
    perPage: opts.perPage,
    ref: opts.ref,
  });

  if (opts.json) {
    console.log(JSON.stringify(results, null, 2));
    return;
  }

  if (!results.length) { console.log('No results.'); return; }

  console.log('Found ' + results.length + ' match(es):\n');
  for (const r of results) {
    const snippet = r.data.trimEnd().split('\n').slice(0, 4).join('\n');
    console.log('📄 ' + r.path + '  (line ' + r.startline + ', ref: ' + r.ref + ')');
    console.log('   ' + snippet.replace(/\n/g, '\n   '));
    console.log();
  }
}

main().catch(function(err) { console.error('Fatal:', err.message); process.exit(1); });
