#!/usr/bin/env node
'use strict';
// gitlab-search-all-projects-v3 — pipeline search across GitLab projects
// Generated/modified by AI RooCode 3.54.0, used model google/claude-sonnet-4-6
//
// Architecture: true producer-consumer pipeline
//   Producer: fetches project list pages continuously, pushes into async queue
//   Consumer pool: N workers pull from queue immediately, search, output JSONL
//   No barrier between pages — workers never idle waiting for next page fetch
//
// Usage:
//   gitlab-search-all-projects-v3 <scope_url> <keyword> [options]
//
// Options:
//   --filter <str>       Filter: "extension:py" | "filename:*.json" | "path:src/"
//   --concurrency <n>    Max parallel searches (default: 8)
//   --per-page <n>       Results per project, max 100 (default: 20)
//   --ref <branch>       Branch/tag to search (default: project default branch)
//   --hits-only          Only output projects with hits (suppress zero-hit lines)
//   --json               Output a single JSON array at end instead of JSONL stream
//
// Output (default): JSON Lines, one object per project, emitted as soon as ready
// Output (--json):  Single JSON array after all projects processed
//
// Required env vars:
//   GITLAB_SEARCH_URI    — GitLab API base, e.g. https://gitlab.example.com/api/v4
//   GITLAB_SEARCH_TOKEN  — Personal access token with read_api scope

const api = require('./gitlab-api.js');

// ---------------------------------------------------------------------------
// Async queue — decouples producer from consumer pool
// ---------------------------------------------------------------------------
function makeQueue() {
  const items = [];
  const waiters = [];
  let done = false;

  return {
    // Producer calls push() for each project
    push(item) {
      if (waiters.length > 0) {
        // A consumer is already waiting — hand off directly
        waiters.shift()(item);
      } else {
        items.push(item);
      }
    },
    // Producer calls close() when all pages are fetched
    close() {
      done = true;
      // Wake up all waiting consumers so they can exit
      while (waiters.length > 0) waiters.shift()(null);
    },
    // Consumer calls pop() — resolves with item or null (queue closed + empty)
    pop() {
      if (items.length > 0) return Promise.resolve(items.shift());
      if (done) return Promise.resolve(null);
      return new Promise(resolve => waiters.push(resolve));
    },
  };
}

// ---------------------------------------------------------------------------
// Arg parsing
// ---------------------------------------------------------------------------
function parseArgs(argv) {
  const opts = {
    scopeUrl: null, keyword: null, filter: null,
    concurrency: 8, perPage: 20, ref: null,
    hitsOnly: false, json: false,
  };
  let i = 0;
  if (argv[i] && !argv[i].startsWith('--')) opts.scopeUrl = argv[i++];
  if (argv[i] && !argv[i].startsWith('--')) opts.keyword  = argv[i++];
  while (i < argv.length) {
    switch (argv[i]) {
      case '--filter':      opts.filter      = argv[++i]; break;
      case '--concurrency': opts.concurrency = parseInt(argv[++i], 10); break;
      case '--per-page':    opts.perPage     = parseInt(argv[++i], 10); break;
      case '--ref':         opts.ref         = argv[++i]; break;
      case '--hits-only':   opts.hitsOnly    = true; break;
      case '--json':        opts.json        = true; break;
      default:
        process.stderr.write('Unknown option: ' + argv[i] + '\n');
        process.exit(1);
    }
    i++;
  }
  if (!opts.scopeUrl) {
    process.stderr.write('Usage: gitlab-search-all-projects-v3 <scope_url> <keyword> [options]\n');
    process.exit(1);
  }
  if (!opts.keyword) {
    process.stderr.write('Error: <keyword> is required\n');
    process.exit(1);
  }
  return opts;
}

// ---------------------------------------------------------------------------
// Producer: fetch all project list pages, push each project into queue
// ---------------------------------------------------------------------------
async function producer(queue, uri, token, listUrl, onProgress) {
  let url = listUrl;
  let totalFetched = 0;
  while (url) {
    const resp = await api.apiFetch(url, token);
    const page = await resp.json();
    if (!Array.isArray(page) || page.length === 0) break;
    for (const project of page) queue.push(project);
    totalFetched += page.length;
    onProgress(totalFetched);
    const nextPage = resp.headers.get('x-next-page');
    if (!nextPage) break;
    const u = new URL(url);
    u.searchParams.set('page', nextPage);
    url = u.toString();
  }
  queue.close();
  return totalFetched;
}

// ---------------------------------------------------------------------------
// Consumer: pull projects from queue, search, emit results
// ---------------------------------------------------------------------------
async function consumer(queue, uri, token, searchTerm, opts, onResult) {
  while (true) {
    const project = await queue.pop();
    if (project === null) break; // queue closed and empty

    let hits;
    try {
      hits = await api.searchProjectBlobs(uri, token, project.id, searchTerm, {
        perPage: opts.perPage,
        ref: opts.ref,
      });
    } catch (err) {
      process.stderr.write('  ⚠️  ' + project.path_with_namespace + ': ' + err.message + '\n');
      hits = [];
    }

    onResult({
      project_id: project.id,
      project_path: project.path_with_namespace,
      default_branch: project.default_branch,
      hits,
    });
  }
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------
// Detect scope type from URL:
//   https://host/group/*          -> { type:'group', group:'group' }
//   https://host/group/sub/*      -> { type:'group', group:'group/sub' }
//   https://host/*/*              -> { type:'all' }
//   https://host/group/project    -> { type:'project', path:'group/project' }
function detectScope(scopeUrl) {
  const url = new URL(scopeUrl.trim());
  const parts = url.pathname.replace(/^\//, '').split('/').filter(Boolean);
  if (parts.length === 0) return { type: 'all' };
  if (parts[parts.length - 1] === '*') {
    if (parts.length === 1 || (parts.length === 2 && parts[0] === '*')) return { type: 'all' };
    return { type: 'group', group: parts.slice(0, -1).join('/') };
  }
  // No trailing * → single project path
  return { type: 'project', path: parts.join('/') };
}

async function main() {
  const opts = parseArgs(process.argv.slice(2));
  const { uri, token } = api.requireEnv();
  const scope = detectScope(opts.scopeUrl);
  const searchTerm = api.buildSearchTerm(opts.keyword, opts.filter);

  process.stderr.write('🔍 Keyword:     "' + searchTerm + '"\n');
  process.stderr.write('   Scope:       ' + opts.scopeUrl + '\n');
  process.stderr.write('   Concurrency: ' + opts.concurrency + '\n\n');

  // Single-project fast path — no queue needed
  if (scope.type === 'project') {
    process.stderr.write('📁 Single-project mode: ' + scope.path + '\n\n');
    // Fetch project metadata first
    const projResp = await api.apiFetch(uri + '/projects/' + encodeURIComponent(scope.path), token);
    const project = await projResp.json();
    let hits;
    try {
      hits = await api.searchProjectBlobs(uri, token, project.id, searchTerm, {
        perPage: opts.perPage, ref: opts.ref,
      });
    } catch (err) {
      process.stderr.write('  ⚠️  ' + scope.path + ': ' + err.message + '\n');
      hits = [];
    }
    const entry = {
      project_id: project.id,
      project_path: project.path_with_namespace,
      default_branch: project.default_branch,
      hits,
    };
    if (opts.json) {
      process.stdout.write(JSON.stringify([entry], null, 2) + '\n');
    } else {
      process.stdout.write(JSON.stringify(entry) + '\n');
      if (hits.length > 0) process.stderr.write('📄 ' + project.path_with_namespace + ': ' + hits.length + ' hit(s)\n');
    }
    process.stderr.write('\n✅ Done! 1 project searched, ' + (hits.length > 0 ? 1 : 0) + ' had matches.\n');
    return;
  }

  const listUrl = scope.type === 'group'
    ? uri + '/groups/' + encodeURIComponent(scope.group) + '/projects?include_subgroups=true&per_page=100'
    : uri + '/projects?membership=true&per_page=100';

  const queue = makeQueue();

  // Accumulate results only in --json mode; in streaming mode emit immediately
  const allResults = opts.json ? [] : null;
  let totalProjects = 0;
  let totalSearched = 0;
  let totalHits = 0;

  // Result handler — called by each consumer as soon as a project is done
  function onResult(entry) {
    totalSearched++;
    if (entry.hits.length > 0) totalHits++;

    if (opts.json) {
      allResults.push(entry);
    } else {
      if (!opts.hitsOnly || entry.hits.length > 0) {
        process.stdout.write(JSON.stringify(entry) + '\n');
      }
      if (entry.hits.length > 0) {
        process.stderr.write('📄 ' + entry.project_path + ': ' + entry.hits.length + ' hit(s)\n');
      }
    }

    // Progress ticker on stderr every 10 projects
    if (totalSearched % 10 === 0) {
      process.stderr.write('   Searched ' + totalSearched + '/' + (totalProjects || '?') + ' projects...\n');
    }
  }

  // Launch producer and consumer pool concurrently — this is the key difference
  // Producer feeds the queue while consumers drain it simultaneously
  const producerPromise = producer(
    queue, uri, token, listUrl,
    (n) => { totalProjects = n; }
  );

  const consumerPromises = Array.from(
    { length: opts.concurrency },
    () => consumer(queue, uri, token, searchTerm, opts, onResult)
  );

  // Wait for producer to finish fetching all pages AND all consumers to drain queue
  const [fetchedCount] = await Promise.all([producerPromise, ...consumerPromises]);

  if (opts.json) {
    process.stdout.write(JSON.stringify(allResults, null, 2) + '\n');
  }

  process.stderr.write(
    '\n✅ Done! Searched ' + totalSearched + ' project(s), ' +
    totalHits + ' had matches.\n'
  );
}

main().catch(err => { process.stderr.write('Fatal: ' + err.message + '\n'); process.exit(1); });
